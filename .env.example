# ---------------------------------------------------------------
# TaskTeens environment variables
# Leave the Supabase values empty to run in LOCAL DEMONSTRATION MODE
# (mock data + browser localStorage, no real accounts or emails).
# ---------------------------------------------------------------

# Public site URL (used in email links and auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser. Used by /api/notify/* routes to look up
# recipient emails for transactional mail after verifying the caller's session.
SUPABASE_SERVICE_ROLE_KEY=

# Resend transactional email (https://resend.com)
RESEND_API_KEY=
# Must be on a domain you have verified in Resend
EMAIL_FROM="TaskTeens <notifications@yourdomain.org>"
# Where safety / emergency reports are copied
SAFETY_INBOX=safety@yourdomain.org
